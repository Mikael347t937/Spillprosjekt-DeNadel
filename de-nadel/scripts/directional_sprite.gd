# Використовуємо вузол спрайта, який уміє програвати покадрові анімації.
extends AnimatedSprite2D

# Оновлюємо вигляд за рухом і додатковим напрямком; без другого аргументу він дорівнює нулю.
func update_motion(motion: Vector2, facing_hint: Vector2 = Vector2.ZERO) -> void:
	# Вважаємо персонажа рухомим, якщо квадрат довжини переміщення більший за малий поріг.
	var moving = motion.length_squared() > 0.01
	# Під час руху беремо його фактичний напрямок, а під час стояння — додатковий напрямок.
	var direction = motion if moving else facing_hint
	# Змінюємо напрямок погляду лише за наявності достатнього вектора; інакше зберігаємо попередній.
	if direction.length_squared() > 0.01:
		# Порівнюємо величини руху по горизонталі та вертикалі без урахування знака.
		if absf(direction.x) > absf(direction.y):
			# Якщо горизонтальний рух переважає, вибираємо бокову анімацію; якщо її немає — передню.
			animation = &"side" if sprite_frames.has_animation(&"side") else &"front"
			# Боковий малюнок дивиться вліво, тому віддзеркалюємо його при русі праворуч.
			flip_h = animation == &"side" and direction.x > 0
		# Якщо вертикальна складова не менша за горизонтальну, вибираємо вертикальний вигляд.
		else:
			# Від’ємний напрямок по вертикалі означає рух угору: показуємо спину; інакше — передній вигляд.
			animation = &"back" if direction.y < 0 else &"front"
			# Вимикаємо горизонтальне віддзеркалення для переднього та заднього виглядів.
			flip_h = false
	# Перевіряємо, чи персонаж справді рухається, щоб керувати відтворенням анімації.
	if moving:
		# Запускаємо вибрану анімацію руху.
		play()
	# Якщо персонаж не рухається, переходимо до пози спокою.
	else:
		# Зупиняємо анімацію, щоб персонаж не крокував на місці.
		stop()
		# Показуємо перший кадр вибраної анімації; відлік кадрів починається з нуля.
		frame = 0
